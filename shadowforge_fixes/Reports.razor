@page "/reports"
@rendermode InteractiveServer
@inject DashboardStateService State
@inject IReportService ReportSvc
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>ShadowForge — Reports</PageTitle>

<div class="sf-page">
    <div class="sf-page-header">
        <div>
            <h1 class="sf-page-title">Simulation Reports</h1>
            <p class="sf-page-sub">Session summary and findings export</p>
        </div>
        @if (State.ModuleResults.Any())
        {
            <button class="sf-btn sf-btn-primary" @onclick="ExportPdfAsync" disabled="@_exporting">
                @if (_exporting)
                {
                    <span>⟳ Generating PDF…</span>
                }
                else
                {
                    <span>⬇ Export PDF Report</span>
                }
            </button>
        }
    </div>

    @if (_exportError is not null)
    {
        <div class="sf-panel sf-mb" style="border-left: 3px solid #ef4444; padding: 12px 16px; color: #ef4444; font-size: 13px;">
            ⚠ PDF export failed: @_exportError
        </div>
    }

    @if (!State.ModuleResults.Any())
    {
        <div class="sf-panel sf-empty-panel">
            <div class="sf-empty-icon">▤</div>
            <div>No simulation data yet.</div>
            <div class="sf-hint">Complete a simulation to generate a report.</div>
        </div>
    }
    else
    {
        <!-- Executive summary -->
        <div class="sf-panel sf-mb">
            <div class="sf-panel-header"><span>Executive Summary</span></div>
            <div class="sf-exec-grid">
                <div class="sf-exec-stat">
                    <span class="sf-exec-num">@State.TotalEvents</span>
                    <span class="sf-exec-label">Total Simulated Events</span>
                </div>
                <div class="sf-exec-stat">
                    <span class="sf-exec-num sf-threat-critical">@State.CriticalCount</span>
                    <span class="sf-exec-label">Critical Severity</span>
                </div>
                <div class="sf-exec-stat">
                    <span class="sf-exec-num sf-threat-high">@State.HighCount</span>
                    <span class="sf-exec-label">High Severity</span>
                </div>
                <div class="sf-exec-stat">
                    <span class="sf-exec-num">@State.MitreMappings.Count</span>
                    <span class="sf-exec-label">MITRE Techniques</span>
                </div>
                <div class="sf-exec-stat">
                    <span class="sf-exec-num">@State.HostCount</span>
                    <span class="sf-exec-label">Hosts Discovered</span>
                </div>
                <div class="sf-exec-stat">
                    <span class="sf-exec-num sf-threat-high">@State.CompromisedCount</span>
                    <span class="sf-exec-label">Hosts Compromised</span>
                </div>
            </div>
        </div>

        <!-- Per-module results -->
        @foreach (var result in State.ModuleResults)
        {
            <div class="sf-panel sf-mb">
                <div class="sf-panel-header">
                    <span>@result.ModuleName</span>
                    <span class="sf-badge @(result.Status == ModuleStatus.Completed ? "sf-badge-ok" : "sf-badge-danger")">
                        @result.Status
                    </span>
                </div>
                <div class="sf-report-meta">
                    <span>Duration: <strong>@result.Duration.TotalSeconds.ToString("F2")s</strong></span>
                    <span>Events: <strong>@result.Events.Count</strong></span>
                    <span>Peak threat: <strong class="sf-threat-@result.HighestThreatLevel.ToString().ToLower()">@result.HighestThreatLevel</strong></span>
                </div>

                @if (result.Events.Any())
                {
                    <div class="sf-report-events">
                        @foreach (var evt in result.Events.OrderByDescending(e => e.ThreatLevel).Take(10))
                        {
                            <div class="sf-event sf-event-sm">
                                <span class="sf-threat-@evt.ThreatLevel.ToString().ToLower() sf-event-badge">@evt.ThreatLevel</span>
                                <span class="sf-event-type">@evt.Type</span>
                                <span class="sf-event-desc">@evt.Description</span>
                                @if (evt.MitreTechniqueId is not null)
                                {
                                    <a class="sf-mitre-tag" href="https://attack.mitre.org/techniques/@evt.MitreTechniqueId.Replace(".", "/")" target="_blank">@evt.MitreTechniqueId</a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- MITRE summary table -->
        @if (State.MitreMappings.Any())
        {
            <div class="sf-panel">
                <div class="sf-panel-header"><span>MITRE ATT&CK Summary</span></div>
                <table class="sf-table">
                    <thead>
                        <tr><th>Technique ID</th><th>Name</th><th>Tactic</th><th>Severity</th><th>Observed</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in State.MitreMappings.OrderByDescending(x => x.TimesObserved))
                        {
                            <tr>
                                <td><a class="sf-mitre-tag" href="@m.Url" target="_blank">@m.TechniqueId</a></td>
                                <td>@m.TechniqueName</td>
                                <td>@m.Tactic</td>
                                <td><span class="sf-threat-@m.Severity.ToString().ToLower()">@m.Severity</span></td>
                                <td>@m.TimesObserved</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private bool   _exporting   = false;
    private string? _exportError = null;

    protected override void OnInitialized() => State.OnStateChanged += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.OnStateChanged -= Refresh;

    private async Task ExportPdfAsync()
    {
        _exporting   = true;
        _exportError = null;
        StateHasChanged();

        try
        {
            // Build report object from current dashboard state
            var report = new SimulationReport
            {
                SessionId      = State.CurrentSessionId,
                Title          = $"ShadowForge APT Simulation — {DateTime.UtcNow:yyyy-MM-dd HH:mm} UTC",
                GeneratedAt    = DateTime.UtcNow,
                Analyst        = "ShadowForge AutoReport",
                ModuleResults  = State.ModuleResults,
                MitreMappings  = State.MitreMappings,
                DiscoveredHosts = State.DiscoveredHosts,
                IOCsIdentified = State.IOCPulses,
                Summary = new ExecutiveSummary
                {
                    TotalEventsGenerated = State.TotalEvents,
                    HostsDiscovered      = State.HostCount,
                    CriticalFindings     = State.CriticalCount,
                    Overview             = "This report summarises the ShadowForge APT emulation session. " +
                                          "All activity was simulated in a controlled environment.",
                    Recommendations =
                    [
                        "Patch all Critical and High severity findings within 72 hours.",
                        "Review and harden lateral movement vectors identified in this session.",
                        "Enable additional logging for MITRE techniques observed.",
                        "Conduct a follow-up simulation after remediations are applied."
                    ]
                }
            };

            var pdfBytes = await ReportSvc.ExportToPdfAsync(report);

            // Trigger browser download via JS interop
            var b64 = Convert.ToBase64String(pdfBytes);
            var filename = $"ShadowForge_Report_{DateTime.UtcNow:yyyyMMdd_HHmm}.pdf";
            await JS.InvokeVoidAsync("shadowforgeDownloadPdf", b64, filename);
        }
        catch (Exception ex)
        {
            _exportError = ex.Message;
        }
        finally
        {
            _exporting = false;
        }
    }
}
