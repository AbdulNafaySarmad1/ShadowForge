@* ── Threat Intel Page ─────────────────────────────────────────────── *@
@* File: Components/Pages/ThreatIntel.razor *@
@page "/threatintel"
@rendermode InteractiveServer
@inject IThreatIntelService ThreatIntelSvc
@inject DashboardStateService State

<PageTitle>ShadowForge — Threat Intelligence</PageTitle>

<div class="sf-page">
    <div class="sf-page-header">
        <div>
            <h1 class="sf-page-title">Threat Intelligence</h1>
            <p class="sf-page-sub">Live feeds from AlienVault OTX · AbuseIPDB</p>
        </div>
        <button class="sf-btn sf-btn-ghost" @onclick="RefreshFeedsAsync" disabled="@_loading">
            @(_loading ? "⟳ Loading…" : "⟳ Refresh")
        </button>
    </div>

    <!-- IP Lookup -->
    <div class="sf-panel sf-mb">
        <div class="sf-panel-header"><span>IP Reputation Lookup</span><span class="sf-badge sf-badge-otx">Live</span></div>
        <div class="sf-lookup-row">
            <input class="sf-input sf-input-wide" @bind="_lookupIp" placeholder="Enter IP address (e.g. 1.1.1.1)" />
            <button class="sf-btn sf-btn-primary" @onclick="LookupIpAsync" disabled="@_lookupLoading">
                @(_lookupLoading ? "Checking…" : "Check IP")
            </button>
        </div>
        @if (_lookupResult is not null)
        {
            <div class="sf-ip-result sf-threat-border-@_lookupResult.ThreatLevel.ToString().ToLower()">
                <div class="sf-ip-row">
                    <span class="sf-ip-label">IP</span><strong>@_lookupResult.IpAddress</strong>
                    <span class="sf-threat-@_lookupResult.ThreatLevel.ToString().ToLower() sf-ip-level">@_lookupResult.ThreatLevel</span>
                </div>
                <div class="sf-ip-row"><span class="sf-ip-label">Abuse Score</span><span>@_lookupResult.AbuseScore / 100</span></div>
                <div class="sf-ip-row"><span class="sf-ip-label">ISP</span><span>@(_lookupResult.Isp ?? "N/A")</span></div>
                <div class="sf-ip-row"><span class="sf-ip-label">Country</span><span>@(_lookupResult.CountryCode ?? "N/A")</span></div>
                @if (_lookupResult.Tags.Any())
                {
                    <div class="sf-ip-tags">
                        @foreach (var tag in _lookupResult.Tags) { <span class="sf-tag">@tag</span> }
                    </div>
                }
            </div>
        }
    </div>

    <!-- IOC Pulse feed -->
    <div class="sf-panel">
        <div class="sf-panel-header">
            <span>Latest OTX Pulses</span>

            @* ── SEVERITY FILTER ── *@
            <div class="sf-filter-row">
                <span class="sf-filter-label">Filter:</span>
                @foreach (var level in _allLevels)
                {
                    <button class="sf-filter-btn @(_activeFilter == level ? "sf-filter-btn-active sf-threat-" + level.ToString().ToLower() : "")"
                            @onclick="() => SetFilter(level)">
                        @level
                    </button>
                }
            </div>
        </div>

        @if (_loading)
        {
            <div class="sf-empty">Fetching live threat feeds…</div>
        }
        else
        {
            var visible = FilteredPulses.ToList();
            @if (!visible.Any())
            {
                <div class="sf-empty">No pulses match the selected severity.</div>
            }
            else
            {
                <div class="sf-pulse-list">
                    @foreach (var pulse in visible)
                    {
                        <div class="sf-pulse-row">
                            <div class="sf-pulse-left">
                                <span class="sf-threat-@pulse.ThreatLevel.ToString().ToLower() sf-pulse-sev">@pulse.ThreatLevel</span>
                                <div>
                                    <div class="sf-pulse-name">@pulse.Name</div>
                                    <div class="sf-pulse-desc">@pulse.Description</div>
                                </div>
                            </div>
                            <div class="sf-pulse-right">
                                <span class="sf-pulse-count">@pulse.IndicatorCount IOCs</span>
                                <div class="sf-pulse-tags">
                                    @foreach (var tag in pulse.Tags.Take(3))
                                    { <span class="sf-tag">@tag</span> }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    private bool _loading      = false;
    private bool _lookupLoading = false;
    private string _lookupIp   = string.Empty;
    private IpReputation? _lookupResult;

    // ── Severity filter state ─────────────────────────────────────────────────
    // null = show all
    private ThreatLevel? _activeFilter = null;

    private static readonly ThreatLevel?[] _allLevels =
        [null, ThreatLevel.Critical, ThreatLevel.High, ThreatLevel.Medium, ThreatLevel.Low, ThreatLevel.None];

    private IEnumerable<ThreatIndicator> FilteredPulses =>
        _activeFilter is null
            ? State.IOCPulses
            : State.IOCPulses.Where(p => p.ThreatLevel == _activeFilter);

    private void SetFilter(ThreatLevel? level)
    {
        _activeFilter = level;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync() => await RefreshFeedsAsync();

    private async Task RefreshFeedsAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var pulses = await ThreatIntelSvc.GetLatestPulsesAsync(20);
            State.SetIOCPulses(pulses);
        }
        finally { _loading = false; }
    }

    private async Task LookupIpAsync()
    {
        if (string.IsNullOrWhiteSpace(_lookupIp)) return;
        _lookupLoading = true;
        StateHasChanged();
        try { _lookupResult = await ThreatIntelSvc.CheckIpReputationAsync(_lookupIp.Trim()); }
        finally { _lookupLoading = false; }
    }
}
